#!/bin/bash
# Launcher entry for TARS remote. The launcher exec's this file directly (no arguments), so the environment is set here.
export HOME="${HOME:-$(getent passwd "$(id -u)" | cut -d: -f6)}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
exec "$HOME/cz-ai/venv/bin/python" "$HOME/cz-ai/tars/tars_remote.py" --event-log "$HOME/cz-ai/logs/tars.jsonl" "$@"
