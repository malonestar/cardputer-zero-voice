+
+#pragma once
+
+#include <algorithm>
+#include <cctype>
+#include <chrono>
+#include <cstddef>
+#include <functional>
+#include <mutex>
+#include <string>
+#include <utility>
+#include <vector>
+
+/*
+ * Thread bridge between the automation RPC broker thread and the LVGL thread.
+ *
+ * The broker thread never touches Launch or LVGL. It reads an immutable
+ * snapshot published by the LVGL thread (so `apps` / `current` answer
+ * instantly, even while an external app blocks the UI thread) and posts at
+ * most one pending request. The LVGL thread drains that request from a timer.
+ * No LVGL lock is taken anywhere in this class.
+ */
+
+enum class LauncherRpcMode
+{
+    NOT_READY,
+    HOME,         // carousel visible, nothing in the foreground
+    PAGE,         // built-in page (or terminal page) in the foreground
+    EXTERNAL,     // external executable owns the framebuffer
+    HOME_PENDING, // built-in page is returning home
+};
+
+inline const char *launcher_rpc_mode_name(LauncherRpcMode mode)
+{
+    switch (mode) {
+    case LauncherRpcMode::HOME: return "home";
+    case LauncherRpcMode::PAGE: return "page";
+    case LauncherRpcMode::EXTERNAL: return "external";
+    case LauncherRpcMode::HOME_PENDING: return "home_pending";
+    default: return "not_ready";
+    }
+}
+
+struct LauncherRpcSnapshot
+{
+    LauncherRpcMode mode = LauncherRpcMode::NOT_READY;
+    std::vector<std::string> apps;
+    std::size_t current = 0;
+    std::string foreground; // empty unless mode is PAGE / EXTERNAL / HOME_PENDING
+};
+
+enum class LauncherRpcRequestKind
+{
+    NONE,
+    HOME,
+    LAUNCH,
+};
+
+struct LauncherRpcRequest
+{
+    LauncherRpcRequestKind kind = LauncherRpcRequestKind::NONE;
+    std::string name;
+};
+
+namespace launcher_rpc {
+
+inline std::string ascii_lower(std::string text)
+{
+    std::transform(text.begin(), text.end(), text.begin(),
+                   [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+    return text;
+}
+
+// Case-insensitive exact match first, then a unique case-insensitive prefix.
+// Returns the index, -1 when nothing matches, -2 when a prefix is ambiguous.
+inline int find_app(const std::vector<std::string> &apps, const std::string &query)
+{
+    const std::string wanted = ascii_lower(query);
+    if (wanted.empty()) return -1;
+    int prefix_match = -1;
+    bool ambiguous = false;
+    for (std::size_t i = 0; i < apps.size(); ++i) {
+        const std::string name = ascii_lower(apps[i]);
+        if (name == wanted) return static_cast<int>(i);
+        if (name.compare(0, wanted.size(), wanted) == 0) {
+            if (prefix_match >= 0) ambiguous = true;
+            prefix_match = static_cast<int>(i);
+        }
+    }
+    if (ambiguous) return -2;
+    return prefix_match;
+}
+
+inline std::string one_line(std::string text)
+{
+    std::replace(text.begin(), text.end(), '\n', ' ');
+    std::replace(text.begin(), text.end(), '\r', ' ');
+    return text;
+}
+
+} // namespace launcher_rpc
+
+class LauncherRpcBridge
+{
+public:
+    using Clock = std::chrono::steady_clock;
+    // A queued request that the UI thread has not completed in this long is dropped.
+    static constexpr std::chrono::seconds kRequestTtl{20};
+
+    // Hook that asks a running external app to end (see cp0_external_app_control).
+    void set_external_terminate_hook(std::function<bool()> hook)
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        terminate_hook_ = std::move(hook);
+    }
+
+    // ---- LVGL thread ----------------------------------------------------
+    void publish(LauncherRpcSnapshot snapshot)
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        snapshot_ = std::move(snapshot);
+    }
+
+    LauncherRpcRequest pending(Clock::time_point now = Clock::now())
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (request_.kind != LauncherRpcRequestKind::NONE && now - queued_at_ > kRequestTtl)
+            request_ = {};
+        return request_;
+    }
+
+    void clear_pending()
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        request_ = {};
+    }
+
+    // ---- RPC broker thread ----------------------------------------------
+    // Returns the complete reply ("OK ..." or "ERR ...") for apps/current/launch/home,
+    // and an empty string for any other command (caller falls through).
+    std::string handle(const std::string &command, const std::string &args,
+                       Clock::time_point now = Clock::now())
+    {
+        if (command != "apps" && command != "current" && command != "launch" && command != "home")
+            return {};
+
+        std::function<bool()> hook;
+        std::string reply;
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            if (snapshot_.mode == LauncherRpcMode::NOT_READY)
+                return "ERR launcher not ready";
+
+            if (command == "apps") {
+                reply = "OK apps";
+                for (const auto &name : snapshot_.apps) reply += "\n" + launcher_rpc::one_line(name);
+                return reply;
+            }
+            if (command == "current") {
+                const std::string selected = snapshot_.current < snapshot_.apps.size()
+                    ? launcher_rpc::one_line(snapshot_.apps[snapshot_.current]) : std::string();
+                return "OK current\nselected=" + selected +
+                       "\nindex=" + std::to_string(snapshot_.current) +
+                       "\nmode=" + launcher_rpc_mode_name(snapshot_.mode) +
+                       "\nforeground=" + launcher_rpc::one_line(snapshot_.foreground);
+            }
+
+            if (command == "launch") {
+                if (args.empty()) return "ERR usage: launch <app name>";
+                const int index = launcher_rpc::find_app(snapshot_.apps, args);
+                if (index == -2) return "ERR ambiguous app name";
+                if (index < 0) return "ERR unknown app";
+                request_ = {LauncherRpcRequestKind::LAUNCH, snapshot_.apps[static_cast<std::size_t>(index)]};
+                reply = "OK launch " + launcher_rpc::one_line(request_.name);
+            } else { // home
+                if (snapshot_.mode == LauncherRpcMode::HOME && request_.kind == LauncherRpcRequestKind::NONE)
+                    return "OK home already";
+                request_ = {LauncherRpcRequestKind::HOME, {}};
+                reply = "OK home";
+            }
+            queued_at_ = now;
+            if (snapshot_.mode == LauncherRpcMode::EXTERNAL) hook = terminate_hook_;
+        }
+        // Outside the lock: the hook is lock-free but must not run under our mutex.
+        if (hook) hook();
+        return reply;
+    }
+
+private:
+    std::mutex mutex_;
+    LauncherRpcSnapshot snapshot_;
+    LauncherRpcRequest request_;
+    Clock::time_point queued_at_{};
+    std::function<bool()> terminate_hook_;
+};
