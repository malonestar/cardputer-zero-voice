diff --git a/ext_components/cp0_lvgl/src/cp0_automation_ext.cpp b/ext_components/cp0_lvgl/src/cp0_automation_ext.cpp
new file mode 100644
index 0000000..b9d2334
--- /dev/null
+++ b/ext_components/cp0_lvgl/src/cp0_automation_ext.cpp
@@ -0,0 +1,71 @@
+/*
+ * SPDX-FileCopyrightText: 2026 M5Stack Technology CO LTD
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "cp0_automation_ext.hpp"
+
+#include <atomic>
+#include <mutex>
+#include <utility>
+
+namespace {
+
+std::mutex g_handler_mutex;
+Cp0RpcCommandHandler g_handler;
+
+std::atomic<bool> g_external_active{false};
+std::atomic<bool> g_terminate_requested{false};
+
+} // namespace
+
+void cp0_rpc_set_command_handler(Cp0RpcCommandHandler handler)
+{
+    std::lock_guard<std::mutex> lock(g_handler_mutex);
+    g_handler = std::move(handler);
+}
+
+bool cp0_rpc_dispatch_command(const std::string &command, const std::string &args,
+                              std::string &reply)
+{
+    Cp0RpcCommandHandler handler;
+    {
+        std::lock_guard<std::mutex> lock(g_handler_mutex);
+        handler = g_handler;
+    }
+    if (!handler) return false;
+    try {
+        return handler(command, args, reply);
+    } catch (...) {
+        reply = "ERR handler failed";
+        return true;
+    }
+}
+
+namespace cp0_external_app_control {
+
+void set_active(bool active) noexcept
+{
+    if (active) g_terminate_requested.store(false, std::memory_order_release);
+    g_external_active.store(active, std::memory_order_release);
+}
+
+bool active() noexcept
+{
+    return g_external_active.load(std::memory_order_acquire);
+}
+
+bool request_terminate() noexcept
+{
+    if (!g_external_active.load(std::memory_order_acquire)) return false;
+    g_terminate_requested.store(true, std::memory_order_release);
+    return true;
+}
+
+bool consume_terminate() noexcept
+{
+    return g_terminate_requested.exchange(false, std::memory_order_acq_rel);
+}
+
+} // namespace cp0_external_app_control
