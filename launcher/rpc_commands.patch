+
+// ============================================================
+// Automation RPC bridge (see model/launcher_rpc_bridge.hpp)
+// ============================================================
+void Launch::publish_rpc_state()
+{
+    LauncherRpcSnapshot snapshot;
+    if (!bound_) {
+        rpc_bridge_->publish(std::move(snapshot));
+        return;
+    }
+    snapshot.apps.reserve(app_list.size());
+    for (const app &item : app_list) snapshot.apps.push_back(item.Name);
+    snapshot.current = current_app_index();
+    if (external_active_) {
+        snapshot.mode = LauncherRpcMode::EXTERNAL;
+    } else {
+        switch (page_lifecycle_.state()) {
+        case LauncherPageState::APP_ACTIVE: snapshot.mode = LauncherRpcMode::PAGE; break;
+        case LauncherPageState::HOME_PENDING: snapshot.mode = LauncherRpcMode::HOME_PENDING; break;
+        default: snapshot.mode = LauncherRpcMode::HOME; break;
+        }
+    }
+    if (snapshot.mode != LauncherRpcMode::HOME) snapshot.foreground = foreground_name_;
+    rpc_bridge_->publish(std::move(snapshot));
+}
+
+void Launch::start_rpc_bridge()
+{
+    rpc_bridge_->set_external_terminate_hook(
+        [] { return cp0_external_app_control::request_terminate(); });
+    // The handler owns the bridge, not Launch, so it stays valid if the broker
+    // thread is mid-call while Launch is destroyed.
+    cp0_rpc_set_command_handler(
+        [bridge = rpc_bridge_](const std::string &command, const std::string &args, std::string &reply) {
+            reply = bridge->handle(command, args);
+            return !reply.empty();
+        });
+    if (!rpc_timer_) rpc_timer_ = lv_timer_create(rpc_timer_cb, 100, this);
+    publish_rpc_state();
+}
+
+void Launch::stop_rpc_bridge() noexcept
+{
+    cp0_rpc_set_command_handler(nullptr);
+    try {
+        rpc_bridge_->publish(LauncherRpcSnapshot{});
+        rpc_bridge_->clear_pending();
+    } catch (...) {
+    }
+    if (rpc_timer_) {
+        lv_timer_delete(rpc_timer_);
+        rpc_timer_ = nullptr;
+    }
+}
+
+void Launch::rpc_timer_cb(lv_timer_t *timer) noexcept
+{
+    auto *self = static_cast<Launch *>(lv_timer_get_user_data(timer));
+    if (!self) return;
+    try {
+        self->process_rpc_request();
+    } catch (...) {
+        self->rpc_bridge_->clear_pending();
+    }
+}
+
+// Runs on the LVGL thread. A request stays pending (re-evaluated every tick)
+// until the launcher is back on the home screen, so `launch` works from
+// anywhere: a built-in page is sent home first, an external app is terminated
+// by the broker thread and the request is served once launch_Exec() returns.
+void Launch::process_rpc_request()
+{
+    const LauncherRpcRequest request = rpc_bridge_->pending();
+    if (request.kind == LauncherRpcRequestKind::NONE) return;
+
+    switch (page_lifecycle_.state()) {
+    case LauncherPageState::APP_ACTIVE:
+        go_back_home(); // lv_go_back_home() runs on a later tick of the LVGL loop
+        return;
+    case LauncherPageState::HOME_PENDING:
+        return;
+    case LauncherPageState::STOPPED:
+        rpc_bridge_->clear_pending();
+        return;
+    case LauncherPageState::HOME:
+        break;
+    }
+
+    if (request.kind == LauncherRpcRequestKind::HOME) {
+        rpc_bridge_->clear_pending();
+        return;
+    }
+
+    auto page = launch_page_.lock();
+    if (!page || page->is_navigating()) return; // let the carousel animation finish
+
+    std::vector<std::string> names;
+    names.reserve(app_list.size());
+    for (const app &item : app_list) names.push_back(item.Name);
+    const int index = launcher_rpc::find_app(names, request.name);
+    rpc_bridge_->clear_pending();
+    if (index < 0) {
+        SLOGW("[RPC] launch: app '%s' no longer exists", request.name.c_str());
+        return;
+    }
+    SLOGI("[RPC] launching '%s' (index %d)", request.name.c_str(), index);
+    current_app = index;
+    refresh_home_carousel();
+    launch_app();
+}
