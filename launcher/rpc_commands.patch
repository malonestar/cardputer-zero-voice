diff --git a/projects/APPLaunch/tests/test_launcher_rpc_bridge.cpp b/projects/APPLaunch/tests/test_launcher_rpc_bridge.cpp
new file mode 100644
index 0000000..47a54dd
--- /dev/null
+++ b/projects/APPLaunch/tests/test_launcher_rpc_bridge.cpp
@@ -0,0 +1,75 @@
+/*
+ * SPDX-FileCopyrightText: 2026 M5Stack Technology CO LTD
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "../main/ui/model/launcher_rpc_bridge.hpp"
+
+#include <cassert>
+#include <string>
+
+int main()
+{
+    const std::vector<std::string> apps = {"Settings", "Terminal", "Calculator", "Camera"};
+    assert(launcher_rpc::find_app(apps, "terminal") == 1);
+    assert(launcher_rpc::find_app(apps, "CALCULATOR") == 2);
+    assert(launcher_rpc::find_app(apps, "cal") == 2);
+    assert(launcher_rpc::find_app(apps, "ca") == -2);   // Calculator / Camera
+    assert(launcher_rpc::find_app(apps, "nope") == -1);
+    assert(launcher_rpc::find_app(apps, "") == -1);
+
+    LauncherRpcBridge bridge;
+    assert(bridge.handle("apps", "") == "ERR launcher not ready");
+    assert(bridge.handle("ping", "").empty());
+
+    LauncherRpcSnapshot snap;
+    snap.mode = LauncherRpcMode::HOME;
+    snap.apps = apps;
+    snap.current = 2;
+    bridge.publish(snap);
+
+    assert(bridge.handle("apps", "") == "OK apps\nSettings\nTerminal\nCalculator\nCamera");
+    assert(bridge.handle("current", "") ==
+           "OK current\nselected=Calculator\nindex=2\nmode=home\nforeground=");
+    assert(bridge.handle("home", "") == "OK home already");
+    assert(bridge.pending().kind == LauncherRpcRequestKind::NONE);
+
+    assert(bridge.handle("launch", "") == "ERR usage: launch <app name>");
+    assert(bridge.handle("launch", "zzz") == "ERR unknown app");
+    assert(bridge.handle("launch", "ca") == "ERR ambiguous app name");
+    assert(bridge.pending().kind == LauncherRpcRequestKind::NONE);
+    assert(bridge.handle("launch", "terminal") == "OK launch Terminal");
+    auto request = bridge.pending();
+    assert(request.kind == LauncherRpcRequestKind::LAUNCH && request.name == "Terminal");
+    bridge.clear_pending();
+    assert(bridge.pending().kind == LauncherRpcRequestKind::NONE);
+
+    // External app in the foreground: the terminate hook fires, once per request.
+    int hook_calls = 0;
+    bridge.set_external_terminate_hook([&] { ++hook_calls; return true; });
+    snap.mode = LauncherRpcMode::EXTERNAL;
+    snap.foreground = "Camera";
+    bridge.publish(snap);
+    assert(bridge.handle("current", "").find("mode=external\nforeground=Camera") != std::string::npos);
+    assert(bridge.handle("home", "") == "OK home");
+    assert(hook_calls == 1);
+    assert(bridge.pending().kind == LauncherRpcRequestKind::HOME);
+    assert(bridge.handle("launch", "settings") == "OK launch Settings");
+    assert(hook_calls == 2);
+    assert(bridge.pending().name == "Settings");
+
+    // Built-in page in the foreground: no terminate hook.
+    snap.mode = LauncherRpcMode::PAGE;
+    bridge.publish(snap);
+    assert(bridge.handle("home", "") == "OK home");
+    assert(hook_calls == 2);
+
+    // Requests expire if the UI thread never serves them.
+    const auto now = LauncherRpcBridge::Clock::now();
+    bridge.handle("home", "", now);
+    assert(bridge.pending(now + std::chrono::seconds(5)).kind == LauncherRpcRequestKind::HOME);
+    assert(bridge.pending(now + LauncherRpcBridge::kRequestTtl + std::chrono::seconds(1)).kind ==
+           LauncherRpcRequestKind::NONE);
+    return 0;
+}
