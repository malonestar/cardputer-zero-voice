+/*
+ * SPDX-FileCopyrightText: 2026 M5Stack Technology CO LTD
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#pragma once
+
+#include <functional>
+#include <string>
+
+/*
+ * Extension points for the local automation RPC (cp0_lvgl_rpc.cpp).
+ *
+ * Both are compiled on every platform so that application code can link
+ * without #ifdef. When the ZMQ RPC is not built in, nothing ever invokes the
+ * command handler and the registration is simply inert.
+ */
+
+/*
+ * Handler for application-specific RPC commands. Called on the RPC broker
+ * thread, NOT the LVGL thread: it must not touch LVGL or UI objects directly.
+ * Return true when the command was handled and fill `reply` with the full
+ * response (it must start with "OK" or "ERR "). Return false to fall through
+ * to "ERR unknown command". Pass an empty function to unregister.
+ */
+using Cp0RpcCommandHandler =
+    std::function<bool(const std::string &command, const std::string &args, std::string &reply)>;
+
+void cp0_rpc_set_command_handler(Cp0RpcCommandHandler handler);
+bool cp0_rpc_dispatch_command(const std::string &command, const std::string &args,
+                              std::string &reply);
+
+namespace cp0_external_app_control {
+
+/* Thread-safe, lock-free. The external app runner marks itself active while a
+ * child process group is being supervised. */
+void set_active(bool active) noexcept;
+bool active() noexcept;
+
+/* Ask the supervising loop to end the running external app the same way an
+ * ESC long-press does (SIGTERM to the process group, SIGKILL after the grace
+ * period). Returns false (and does nothing) when no external app is active. */
+bool request_terminate() noexcept;
+
+/* Consumed by the runner loop; true at most once per request. */
+bool consume_terminate() noexcept;
+
+} // namespace cp0_external_app_control
