@@ -41,6 +41,26 @@ def send_key(socket: zmq.Socket, code: int, state: int, mods: int = 0) -> None:
     request(socket, f"key {code} {state} {mods}")
 
 
+def parse_current(socket: zmq.Socket) -> dict[str, str]:
+    body = request(socket, "current")[0].decode("utf-8", "replace")
+    fields = {}
+    for line in body.splitlines()[1:]:
+        key, _, value = line.partition("=")
+        fields[key] = value
+    return fields
+
+
+def wait_for(socket: zmq.Socket, predicate, seconds: float) -> dict[str, str]:
+    deadline = time.monotonic() + seconds
+    while True:
+        state = parse_current(socket)
+        if predicate(state):
+            return state
+        if time.monotonic() >= deadline:
+            raise RuntimeError(f"timed out waiting; last state: {state}")
+        time.sleep(0.1)
+
+
